// Prisma Schema cho Cổng Thông Tin Thực Tập
// Cơ sở dữ liệu: SQL Server
// Thiết kế tinh gọn (7 bảng) - Dễ vẽ sơ đồ ERD & báo cáo môn học

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. BẢNG NGUỜI DÙNG (Chung cho tất cả các vai trò)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed password
  fullName  String
  avatar    String?  // Đường dẫn ảnh đại diện
  role      String   @default("STUDENT") // STUDENT, COMPANY, SCHOOL, ADMIN
  status    String   @default("ACTIVE")  // ACTIVE, INACTIVE, PENDING
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quan hệ 1-1
  studentProfile StudentProfile?
  companyProfile CompanyProfile?

  @@map("Users")
}

// 2. BẢNG HỒ SƠ SINH VIÊN
model StudentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  studentCode String   @unique // Mã sinh viên (MSSV)
  major       String   // Ngành học (VD: Công nghệ thông tin)
  className   String   // Lớp học (VD: DTH205)
  gpa         Float?   // Điểm trung bình tích lũy
  phone       String?  // Số điện thoại
  cvUrl       String?  // Đường dẫn file CV (PDF)
  skills      String?  // Danh sách kỹ năng (cách nhau bởi dấu phẩy)
  bio         String?  // Giới thiệu bản thân

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Quan hệ 1-Nhiều với Đơn ứng tuyển
  applications Application[]

  @@map("StudentProfiles")
}

// 3. BẢNG HỒ SƠ DOANH NGHIỆP
model CompanyProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String   // Tên công ty
  taxCode     String?  // Mã số thuế
  website     String?  // Website công ty
  address     String   // Địa chỉ
  phone       String?  // Số điện thoại liên hệ
  description String?  // Giới thiệu công ty
  isApproved  Boolean  @default(false) // Nhà trường đã phê duyệt chưa

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Quan hệ 1-Nhiều với Bài đăng thực tập
  internships Internship[]

  @@map("CompanyProfiles")
}

// 4. BẢNG TIN ĐĂNG THỰC TẬP
model Internship {
  id           String   @id @default(uuid())
  companyId    String
  title        String   // Tiêu đề tuyển dụng (VD: Thực tập sinh ReactJS)
  description  String   // Mô tả công việc
  requirements String   // Yêu cầu ứng viên
  benefits     String?  // Quyền lợi
  location     String   // Địa điểm làm việc
  salary       String   @default("Thỏa thuận") // Mức lương/trợ cấp
  quantity     Int      @default(1) // Số lượng cần tuyển
  deadline     DateTime // Hạn nộp hồ sơ
  status       String   @default("OPEN") // OPEN, CLOSED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Quan hệ 1-Nhiều với Đơn ứng tuyển
  applications Application[]

  @@map("Internships")
}

// 5. BẢNG ĐƠN ỨNG TUYỂN
model Application {
  id           String   @id @default(uuid())
  internshipId String
  studentId    String
  coverLetter  String?  // Thư giới thiệu
  cvUrl        String?  // CV riêng cho đợt ứng tuyển này
  status       String   @default("PENDING") // PENDING (Đang chờ), ACCEPTED (Được nhận), REJECTED (Từ chối), WORKING (Đang thực tập), COMPLETED (Hoàn thành)
  note         String?  // Ghi chú từ doanh nghiệp

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  internship Internship     @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Quan hệ với Nhật ký & Đánh giá
  diaries     InternshipDiary[]
  evaluations Evaluation[]

  @@map("Applications")
}

// 6. BẢNG NHẬT KÝ THỰC TẬP (Sinh viên viết hàng tuần)
model InternshipDiary {
  id            String   @id @default(uuid())
  applicationId String
  weekNumber    Int      // Tuần thứ mấy (1, 2, 3...)
  title         String   // Tiêu đề báo cáo tuần
  content       String   // Nội dung công việc đã làm
  feedback      String?  // Nhận xét của doanh nghiệp/giảng viên

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("InternshipDiaries")
}

// 7. BẢNG ĐÁNH GIÁ THỰC TẬP (Doanh nghiệp & Trường đánh giá)
model Evaluation {
  id            String   @id @default(uuid())
  applicationId String
  evaluatorRole String   // COMPANY hoặc SCHOOL
  score         Float    // Điểm số (thang điểm 10)
  comment       String   // Nhận xét chi tiết
  criteria      String?  // Chi tiết tiêu chí (JSON string hoặc văn bản)

  createdAt DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("Evaluations")
}
