@model InternshipPortal.ViewModels.Notifications.NotificationListViewModel
@using InternshipPortal.Models.Enums
@{
    ViewData["Title"] = "Trung tâm thông báo";
}

<section class="applications-page">
    <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-white mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <span class="badge bg-light text-muted border rounded-pill px-3 py-1 fw-semibold small mb-2 d-inline-block">TRUNG TÂM THÔNG BÁO</span>
                <h1 class="fs-2 my-1 text-dark">
                    Thông báo của bạn <span class="badge rounded-pill bg-success fs-6 ms-2">@Model.UnreadCount chưa đọc</span>
                </h1>
                <p class="text-muted fs-6 m-0">Cập nhật nhanh các thông tin về hồ sơ ứng tuyển, đợt thực tập và đánh giá.</p>
            </div>

            @if (Model.UnreadCount > 0)
            {
                <form asp-action="MarkAllAsRead" method="post" class="m-0">
                    <button type="submit" class="action-link-outline py-2 px-3 fs-6">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Đánh dấu tất cả đã đọc</span>
                    </button>
                </form>
            }
        </div>

        <!-- Filter tabs -->
        <div class="d-flex gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" asp-route-onlyUnread="false" class="btn btn-sm @(!Model.OnlyUnread ? "btn-primary" : "btn-light") rounded-pill px-3 fw-semibold">
                Tất cả (@Model.TotalCount)
            </a>
            <a asp-action="Index" asp-route-onlyUnread="true" class="btn btn-sm @(Model.OnlyUnread ? "btn-primary" : "btn-light") rounded-pill px-3 fw-semibold">
                Chưa đọc (@Model.UnreadCount)
            </a>
        </div>
    </div>

    @if (TempData["Success"] is string successMsg)
    {
        <div class="notice-success" role="status">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>@successMsg</span>
        </div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="catalog-empty">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5" class="mb-3"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
            <h2>Không có thông báo nào</h2>
            <p>@(Model.OnlyUnread ? "Bạn đã đọc hết tất cả thông báo." : "Hiện tại bạn chưa nhận được thông báo nào từ hệ thống.")</p>
            @if (Model.OnlyUnread)
            {
                <a asp-action="Index" asp-route-onlyUnread="false" class="action-link mt-2">Xem tất cả thông báo</a>
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model.Items)
            {
                var iconColor = item.Type switch
                {
                    NotificationType.ApplicationApproved or NotificationType.CompanyApproved => "text-success",
                    NotificationType.ApplicationRejected => "text-danger",
                    NotificationType.NewPosition => "text-primary",
                    NotificationType.NewEvaluation => "text-warning",
                    _ => "text-info"
                };

                var bgClass = !item.IsRead ? "bg-white border-primary shadow-sm" : "bg-white border-subtle";

                <article class="card p-3 p-md-4 rounded-4 @bgClass transition-card">
                    <div class="d-flex align-items-start gap-3">
                        <div class="portal-icon-badge mt-1 flex-shrink-0" style="background-color: #f8fafc;">
                            @if (item.Type == NotificationType.ApplicationApproved || item.Type == NotificationType.CompanyApproved)
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            }
                            else if (item.Type == NotificationType.ApplicationRejected)
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                            }
                            else if (item.Type == NotificationType.NewPosition)
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                            }
                            else if (item.Type == NotificationType.NewEvaluation)
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                            }
                            else
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                            }
                        </div>

                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
                                <h3 class="fs-6 fw-bold m-0 @(!item.IsRead ? "text-primary" : "text-dark")">
                                    @item.Title
                                    @if (!item.IsRead)
                                    {
                                        <span class="badge bg-danger rounded-circle p-1 ms-1" title="Chưa đọc" style="width: 8px; height: 8px; display: inline-block;"></span>
                                    }
                                </h3>
                                <span class="small text-muted">@item.TimeAgo</span>
                            </div>

                            <p class="text-muted small mb-2 text-break">@item.Message</p>

                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrWhiteSpace(item.TargetUrl))
                                {
                                    <form asp-action="MarkAsRead" asp-route-id="@item.Id" method="post" class="m-0">
                                        <button type="submit" class="btn btn-sm btn-link p-0 text-primary text-decoration-none fw-semibold">
                                            <span>Xem chi tiết →</span>
                                        </button>
                                    </form>
                                }

                                @if (!item.IsRead)
                                {
                                    <form asp-action="MarkAsRead" asp-route-id="@item.Id" method="post" class="m-0">
                                        <button type="submit" class="btn btn-sm btn-link p-0 text-muted text-decoration-none small">
                                            <span>Đánh dấu đã đọc</span>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="catalog-pagination" aria-label="Phân trang thông báo">
                @if (Model.Page > 1)
                {
                    <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-onlyUnread="@Model.OnlyUnread">
                        ← Trang trước
                    </a>
                }

                <span>Trang <strong>@Model.Page</strong> / @Model.TotalPages</span>

                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-onlyUnread="@Model.OnlyUnread">
                        Trang sau →
                    </a>
                }
            </nav>
        }
    }
</section>
