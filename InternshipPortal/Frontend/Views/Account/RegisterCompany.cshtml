@model InternshipPortal.ViewModels.Account.RegisterCompanyViewModel
@{ ViewData["Title"] = "Đăng ký doanh nghiệp"; }

<section class="company-register-page company-register-page--form-only">
    <header class="company-register-header">
        <div>
            <p class="portal-overline">Dành cho doanh nghiệp</p>
            <h1>Đăng ký tài khoản doanh nghiệp</h1>
            <p>Điền thông tin liên hệ và thông tin đơn vị để nhà trường xét duyệt trước khi kích hoạt tài khoản.</p>
        </div>
        <a asp-action="Login" class="company-register-login">Đã có tài khoản? Đăng nhập</a>
    </header>

    <div class="company-register-reference">
        <span>Muốn tìm hiểu trước?</span>
        <a asp-action="Employer">Xem quyền lợi và quy trình hợp tác dành cho doanh nghiệp</a>
    </div>

    <div class="company-register-panel company-register-form">
        <div class="company-register-panel__heading">
            <h2>Thông tin đăng ký</h2>
            <p>Các trường có dấu * là bắt buộc. Nhà trường sẽ liên hệ để xác minh khi cần.</p>
        </div>
        <form asp-action="RegisterCompany" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <fieldset>
                <legend>Thông tin doanh nghiệp</legend>
                <div class="field">
                    <label asp-for="CompanyName"></label>
                    <input asp-for="CompanyName" autocomplete="organization" />
                    <span asp-validation-for="CompanyName"></span>
                </div>
                <div class="field">
                    <label asp-for="Address"></label>
                    <input asp-for="Address" autocomplete="street-address" />
                    <span asp-validation-for="Address"></span>
                </div>
                <div class="field-pair">
                    <div class="field">
                        <label asp-for="TaxCode"></label>
                        <input asp-for="TaxCode" />
                        <span asp-validation-for="TaxCode"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Website"></label>
                        <input asp-for="Website" type="url" placeholder="https://" />
                        <span asp-validation-for="Website"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Người đại diện và tài khoản</legend>
                <partial name="_RegisterFields" model="Model" />
            </fieldset>

            <button class="company-register-submit" type="submit">Gửi đăng ký doanh nghiệp</button>
        </form>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
