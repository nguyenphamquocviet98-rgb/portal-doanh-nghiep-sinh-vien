@model InternshipPortal.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="login-portal">
    <aside class="login-portal__context" aria-labelledby="login-context-title">
        <p class="portal-overline">Cổng thông tin thực tập</p>
        <h1 id="login-context-title">Đăng nhập hệ thống</h1>
        <p>Quản lý hồ sơ, đơn ứng tuyển, nhật ký thực tập và thông tin tuyển dụng trên một cổng dùng chung.</p>

        <div class="login-portal__support">
            <h2>Bạn có thể thực hiện</h2>
            <ul>
                <li>Sinh viên theo dõi hồ sơ và kết quả ứng tuyển.</li>
                <li>Doanh nghiệp quản lý vị trí và ứng viên.</li>
                <li>Nhà trường quản lý đợt thực tập.</li>
            </ul>
        </div>

        <p class="login-portal__register">
            Chưa có tài khoản? <a asp-action="RegisterStudent">Đăng ký sinh viên</a> hoặc <a asp-action="RegisterCompany">đăng ký doanh nghiệp</a>.
        </p>
    </aside>

    <div class="login-portal__form">
        <header>
            <h2>Thông tin đăng nhập</h2>
            @if (!string.IsNullOrEmpty(Model.ReturnUrl))
            {
                <p class="login-portal__continue">Đăng nhập để tiếp tục thao tác bạn đã chọn.</p>
            }
        </header>

        @if (TempData["Success"] is string message)
        {
            <div class="notice-success" role="status">@message</div>
        }

        @if (TempData["Error"] is string errorMessage)
        {
            <div class="login-portal__error" role="alert">@errorMessage</div>
        }

        <form asp-action="Login" method="post" novalidate>
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <div class="field">
                <label asp-for="Email">Địa chỉ email</label>
                <input asp-for="Email" type="email" autocomplete="username" placeholder="name@domain.edu.vn" required />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="field">
                <label asp-for="Password">Mật khẩu</label>
                <input asp-for="Password" type="password" autocomplete="current-password" required />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="remember-field">
                <input asp-for="RememberMe" id="RememberMe" />
                <label asp-for="RememberMe" for="RememberMe" class="m-0 user-select-none">Ghi nhớ đăng nhập trên thiết bị này</label>
            </div>

            <button class="login-portal__submit" type="submit">Đăng nhập</button>
        </form>

        <details class="login-portal__demo">
            <summary>Tài khoản demo dành cho kiểm thử</summary>
            <p>Chỉ dùng khi trình diễn chức năng, không dùng cho dữ liệu thật.</p>
            <div>
                <a href="/Account/QuickLogin?role=admin@(string.IsNullOrEmpty(Model.ReturnUrl) ? "" : $"&returnUrl={System.Net.WebUtility.UrlEncode(Model.ReturnUrl)}")">Quản trị</a>
                <a href="/Account/QuickLogin?role=company@(string.IsNullOrEmpty(Model.ReturnUrl) ? "" : $"&returnUrl={System.Net.WebUtility.UrlEncode(Model.ReturnUrl)}")">Doanh nghiệp</a>
                <a href="/Account/QuickLogin?role=student@(string.IsNullOrEmpty(Model.ReturnUrl) ? "" : $"&returnUrl={System.Net.WebUtility.UrlEncode(Model.ReturnUrl)}")">Sinh viên</a>
            </div>
        </details>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
