@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}

<h1 class="text-danger">Có lỗi xảy ra</h1>
<h2 class="h5">Không thể xử lý yêu cầu. Vui lòng thử lại sau.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Về trang chủ</a>
