@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var items = new[]
    {
        ("Dashboard", "Index", "Tổng quan"),
        ("Profile", "Index", "Hồ sơ của tôi"),
        ("Applications", "Index", "Đơn ứng tuyển"),
        ("Internships", "Index", "Quá trình thực tập"),
        ("Profile", "Cv", "Mẫu CV")
    };
}

<aside class="student-sidebar" aria-label="Điều hướng sinh viên">
    <div class="student-sidebar__header">
        <span>Sinh viên</span>
        <strong>Không gian học tập</strong>
    </div>
    <nav>
        @foreach (var item in items)
        {
            var isCurrent = controller == item.Item1 && (item.Item2 == "Index" ? action == "Index" || (item.Item1 == "Profile" && action == "Edit") : action == item.Item2);
            <a asp-area="Student" asp-controller="@item.Item1" asp-action="@item.Item2" class="@(isCurrent ? "is-current" : "")" aria-current="@(isCurrent ? "page" : null)">
                @item.Item3
            </a>
        }
    </nav>
    <div class="student-sidebar__footer">
        <a asp-area="" asp-controller="Internships" asp-action="Index">Tìm vị trí thực tập</a>
    </div>
</aside>
