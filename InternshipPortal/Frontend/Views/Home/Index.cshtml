@model InternshipPortal.ViewModels.Home.HomeIndexViewModel
@using InternshipPortal.Helpers
@{
    ViewData["Title"] = "Trang chủ";
    var dotThucTap = Model.CurrentPeriod;
}

<div class="portal-page">
    <section class="portal-period" aria-labelledby="period-title">
        <div>
            <p class="portal-overline">Đợt thực tập đang diễn ra</p>
            <h1 id="period-title">@(dotThucTap?.Name ?? "Chưa có đợt thực tập đang mở")</h1>
            @if (dotThucTap is not null)
            {
                <p class="portal-period__time">Thời gian: @dotThucTap.StartDate.VietnamDate() – @dotThucTap.EndDate.VietnamDate()</p>
            }
        </div>
        <div class="portal-period__action">
            <span class="portal-status">Đang mở</span>
            <a asp-controller="Internships" asp-action="Index" class="portal-button">Xem vị trí thực tập</a>
        </div>
    </section>

    <section class="portal-search" aria-labelledby="search-title">
        <h2 id="search-title">Tìm vị trí thực tập</h2>
        <form asp-controller="Internships" asp-action="Index" method="get" class="portal-search__form" role="search">
            <label class="visually-hidden" for="portal-keyword">Từ khóa</label>
            <input id="portal-keyword" type="search" name="keyword" placeholder="Tên vị trí, doanh nghiệp hoặc kỹ năng" maxlength="100" />
            <label class="visually-hidden" for="portal-major">Ngành học</label>
            <select id="portal-major" name="majorId">
                <option value="">Tất cả ngành</option>
                @foreach (var major in Model.MajorOptions)
                {
                    <option value="@major.Value">@major.Text</option>
                }
            </select>
            <label class="visually-hidden" for="portal-location">Địa điểm</label>
            <select id="portal-location" name="location">
                <option value="">Tất cả địa điểm</option>
                @foreach (var location in Model.LocationOptions)
                {
                    <option value="@location.Value">@location.Text</option>
                }
            </select>
            <button type="submit">Tìm kiếm</button>
        </form>
    </section>

    <div class="portal-grid">
        <section class="portal-panel portal-positions" aria-labelledby="positions-title">
            <div class="portal-panel__heading">
                <div>
                    <h2 id="positions-title">Vị trí đang mở</h2>
                    <p>@Model.TotalOpenPositions vị trí đang nhận hồ sơ</p>
                </div>
                <a asp-controller="Internships" asp-action="Index">Xem tất cả</a>
            </div>

            <div class="portal-table-wrap">
                <table class="portal-table">
                    <thead>
                        <tr>
                            <th>Vị trí</th>
                            <th>Doanh nghiệp</th>
                            <th>Ngành</th>
                            <th>Hạn nộp</th>
                            <th><span class="visually-hidden">Thao tác</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var position in Model.LatestPositions.Take(6))
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Internships" asp-action="Details" asp-route-id="@position.Id" class="portal-position-title">@position.Title</a>
                                    <span class="portal-subtext">@position.Location · Còn @position.AvailablePlaces chỗ</span>
                                </td>
                                <td>@position.CompanyName</td>
                                <td>@position.MajorName</td>
                                <td>@position.ApplicationDeadline.VietnamDate()</td>
                                <td><a asp-controller="Internships" asp-action="Details" asp-route-id="@position.Id" class="portal-text-link">Chi tiết</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <aside class="portal-sidebar" aria-label="Thông tin hỗ trợ">
            <section class="portal-panel">
                <div class="portal-panel__heading">
                    <div>
                        <h2>Thông báo</h2>
                        <p>Cập nhật cho sinh viên</p>
                    </div>
                </div>
                <ul class="portal-notices">
                    <li><strong>Hồ sơ thực tập</strong><span>Kiểm tra CV trước khi nộp đơn ứng tuyển.</span></li>
                    <li><strong>Nhật ký thực tập</strong><span>Nộp nhật ký tuần đúng thời hạn được thông báo.</span></li>
                    <li><strong>Hỗ trợ sinh viên</strong><span>Liên hệ phòng Quan hệ doanh nghiệp khi cần hướng dẫn.</span></li>
                </ul>
            </section>

            <section class="portal-panel portal-guide" id="quy-trinh">
                <div class="portal-panel__heading"><div><h2>Quy trình thực tập</h2><p>Thực hiện theo từng bước</p></div></div>
                <ol>
                    <li>Hoàn thiện CV và hồ sơ cá nhân.</li>
                    <li>Chọn vị trí, nộp đơn và theo dõi phản hồi.</li>
                    <li>Thực tập, nộp nhật ký và báo cáo kết quả.</li>
                </ol>
            </section>
        </aside>
    </div>

    <section class="portal-panel portal-companies" id="doanh-nghiep" aria-labelledby="companies-title">
        <div class="portal-panel__heading">
            <div><h2 id="companies-title">Doanh nghiệp đồng hành</h2><p>@Model.TotalApprovedCompanies doanh nghiệp đã được xác thực</p></div>
        </div>
        <div class="portal-company-list">
            @foreach (var company in Model.FeaturedCompanies)
            {
                <a asp-controller="Companies" asp-action="Details" asp-route-id="@company.Id" class="portal-company">
                    <img src="@company.LogoUrl" alt="" />
                    <span><strong>@company.Name</strong><small>@company.Address</small></span>
                </a>
            }
        </div>
    </section>
</div>
