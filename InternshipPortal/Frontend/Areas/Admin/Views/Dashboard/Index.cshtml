@model InternshipPortal.ViewModels.AdminDashboard.AdminDashboardViewModel
@using InternshipPortal.Helpers
@{
    ViewData["Title"] = "Quản trị nhà trường";
    var periodRange = Model.CurrentPeriodStartDate.HasValue && Model.CurrentPeriodEndDate.HasValue
        ? $"{Model.CurrentPeriodStartDate.Value:dd/MM/yyyy} – {Model.CurrentPeriodEndDate.Value:dd/MM/yyyy}"
        : "Chưa có đợt đang mở";
    var majorStats = Model.MajorLabels.Zip(Model.MajorApplicationCounts, (name, count) => new { Name = name, Count = count }).ToList();
    var highestMajorApplicationCount = Math.Max(1, majorStats.Select(x => x.Count).DefaultIfEmpty(0).Max());
}

<section class="admin-dashboard admin-dashboard--operational">
    <header class="admin-dashboard__hero">
        <div>
            <p class="admin-dashboard__eyebrow">TRUNG TÂM ĐIỀU HÀNH</p>
            <h1>Quản trị nhà trường</h1>
            <p>Nhìn nhanh các việc cần xử lý, tiến độ thực tập và hoạt động mới nhất.</p>
        </div>
        <div class="admin-dashboard__hero-actions">
            <a asp-controller="Companies" asp-action="Index" class="admin-dashboard__button admin-dashboard__button--primary">Duyệt doanh nghiệp @if (Model.PendingCompanies > 0) { <span>@Model.PendingCompanies</span> }</a>
            <a asp-controller="Periods" asp-action="Index" class="admin-dashboard__button admin-dashboard__button--secondary">Quản lý đợt</a>
        </div>
    </header>

    <section class="admin-dashboard__priority-grid" aria-label="Việc cần xử lý">
        <a asp-controller="Companies" asp-action="Index" class="admin-dashboard__priority-card @(Model.PendingCompanies > 0 ? "is-attention" : "")">
            <span class="admin-dashboard__priority-kicker">CẦN DUYỆT</span>
            <strong>@Model.PendingCompanies</strong>
            <h2>Doanh nghiệp chờ xét duyệt</h2>
            <p>@(Model.PendingCompanies > 0 ? "Mở hồ sơ để duyệt hoặc từ chối." : "Không có hồ sơ đang chờ.")</p>
            <span class="admin-dashboard__priority-link">Mở danh sách →</span>
        </a>
        <a asp-controller="Monitoring" asp-action="Applications" class="admin-dashboard__priority-card">
            <span class="admin-dashboard__priority-kicker">ĐANG XỬ LÝ</span>
            <strong>@Model.ApplicationsInReview</strong>
            <h2>Đơn ứng tuyển chưa kết thúc</h2>
            <p>Xem các đơn chờ duyệt, đã xem hoặc phỏng vấn.</p>
            <span class="admin-dashboard__priority-link">Theo dõi đơn →</span>
        </a>
        <a asp-controller="Monitoring" asp-action="Internships" class="admin-dashboard__priority-card">
            <span class="admin-dashboard__priority-kicker">CẦN THEO DÕI</span>
            <strong>@Model.InternshipsWithoutDiary</strong>
            <h2>Hồ sơ chưa có nhật ký</h2>
            <p>Trong @Model.ActiveInternships sinh viên đang thực tập.</p>
            <span class="admin-dashboard__priority-link">Xem thực tập →</span>
        </a>
    </section>

    <section class="admin-dashboard__metrics" aria-label="Số liệu tổng quan">
        <a asp-controller="Accounts" asp-action="Index" class="admin-dashboard__metric"><span class="admin-dashboard__metric-label">Sinh viên hoạt động</span><strong>@Model.TotalStudents</strong><small>@Model.PlacedStudentsCount đã được tiếp nhận</small></a>
        <a asp-controller="Companies" asp-action="Index" class="admin-dashboard__metric"><span class="admin-dashboard__metric-label">Doanh nghiệp đã duyệt</span><strong>@Model.TotalCompanies</strong><small>@Model.PendingCompanies chờ xét duyệt</small></a>
        <a asp-controller="Monitoring" asp-action="Positions" class="admin-dashboard__metric"><span class="admin-dashboard__metric-label">Vị trí đang mở</span><strong>@Model.OpenPositions</strong><small>trên @Model.TotalPositions vị trí đã tạo</small></a>
        <a asp-controller="Monitoring" asp-action="Internships" class="admin-dashboard__metric"><span class="admin-dashboard__metric-label">Hồ sơ thực tập</span><strong>@Model.TotalInternships</strong><small>@Model.ActiveInternships đang diễn ra</small></a>
    </section>

    <section class="admin-dashboard__main-grid">
        <article class="admin-dashboard__panel admin-dashboard__recent-panel">
            <div class="admin-dashboard__panel-heading">
                <div><p>HOẠT ĐỘNG MỚI</p><h2>Đơn ứng tuyển gần đây</h2></div>
                <a asp-controller="Monitoring" asp-action="Applications">Xem tất cả</a>
            </div>
            @if (Model.RecentApplications.Count == 0)
            {
                <p class="admin-dashboard__empty">Chưa có đơn ứng tuyển trong hệ thống.</p>
            }
            else
            {
                <div class="admin-dashboard__recent-list">
                    @foreach (var application in Model.RecentApplications)
                    {
                        <a asp-controller="Monitoring" asp-action="Application" asp-route-id="@application.Id">
                            <span class="admin-dashboard__avatar">@application.StudentName[..1]</span>
                            <span class="admin-dashboard__recent-main"><strong>@application.StudentName</strong><small>@application.StudentCode · @application.PositionTitle</small></span>
                            <span class="admin-dashboard__recent-meta"><em>@application.Status.DisplayName()</em><small>@application.CreatedAt.VietnamDateTime()</small></span>
                        </a>
                    }
                </div>
            }
        </article>

        <article class="admin-dashboard__panel admin-dashboard__period-panel">
            <div class="admin-dashboard__panel-heading"><div><p>ĐỢT THỰC TẬP HIỆN TẠI</p><h2>@(Model.CurrentPeriodName ?? "Chưa thiết lập")</h2></div><a asp-controller="Periods" asp-action="Index">Quản lý</a></div>
            <p class="admin-dashboard__period-date">@periodRange</p>
            <div class="admin-dashboard__period-stats">
                <div><strong>@Model.OpenPositions</strong><span>vị trí đang tuyển</span></div>
                <div><strong>@Model.ApplicationsInReview</strong><span>đơn đang xử lý</span></div>
            </div>
            <a asp-controller="Periods" asp-action="Index" class="admin-dashboard__inline-link">Thiết lập trạng thái đợt <span>→</span></a>
        </article>
    </section>

    <section class="admin-dashboard__analytics" aria-label="Tiến độ và nhu cầu">
        <article class="admin-dashboard__panel admin-dashboard__placement">
            <div class="admin-dashboard__panel-heading"><div><p>TIẾN ĐỘ TIẾP NHẬN</p><h2>Sinh viên đã có nơi thực tập</h2></div><strong>@Model.PlacementRate%</strong></div>
            <div class="admin-dashboard__placement-summary">
                <div class="admin-dashboard__placement-numbers"><strong>@Model.PlacedStudentsCount</strong><span>trên @Model.TotalStudents sinh viên đã được tiếp nhận</span></div>
                <div class="admin-dashboard__progress-track" aria-label="@Model.PlacementRate% sinh viên đã có nơi thực tập"><span style="width: @Model.PlacementRate.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                <div class="admin-dashboard__placement-breakdown"><span><i></i>Đã tiếp nhận <strong>@Model.PlacedStudentsCount</strong></span><span><i></i>Chưa có nơi <strong>@Model.UnplacedStudentsCount</strong></span></div>
            </div>
        </article>
        <article class="admin-dashboard__panel">
            <div class="admin-dashboard__panel-heading"><div><p>NHU CẦU ỨNG TUYỂN</p><h2>Đơn theo chuyên ngành</h2></div><a asp-controller="Monitoring" asp-action="Applications">Chi tiết</a></div>
            @if (majorStats.Count == 0)
            {
                <p class="admin-dashboard__empty">Chưa có dữ liệu ứng tuyển theo chuyên ngành.</p>
            }
            else
            {
                <div class="admin-dashboard__major-rank">
                    @foreach (var major in majorStats)
                    {
                        var percent = (int)Math.Round(major.Count * 100d / highestMajorApplicationCount);
                        <div class="admin-dashboard__major-row">
                            <span class="admin-dashboard__major-name" title="@major.Name">@major.Name</span>
                            <div class="admin-dashboard__major-track" aria-label="@major.Name: @major.Count đơn"><span style="width: @percent%"></span></div>
                            <strong>@major.Count</strong>
                        </div>
                    }
                </div>
            }
        </article>
    </section>

    <section class="admin-dashboard__monitoring" aria-label="Giám sát hệ thống">
        <div><p>GIÁM SÁT HỆ THỐNG</p><h2>Tra cứu dữ liệu vận hành</h2><span>Kiểm tra vị trí, đơn ứng tuyển và hồ sơ thực tập khi cần.</span></div>
        <div><a asp-controller="Monitoring" asp-action="Positions">Vị trí</a><a asp-controller="Monitoring" asp-action="Applications">Đơn ứng tuyển</a><a asp-controller="Monitoring" asp-action="Internships">Thực tập</a></div>
    </section>
</section>
