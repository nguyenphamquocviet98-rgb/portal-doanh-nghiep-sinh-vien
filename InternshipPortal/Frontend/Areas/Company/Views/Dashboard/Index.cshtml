@model InternshipPortal.ViewModels.CompanyDashboard.CompanyDashboardViewModel
@using InternshipPortal.Helpers
@{
    ViewData["Title"] = "Tổng quan doanh nghiệp";
}

<section class="company-dashboard">
    <header class="company-dashboard__header">
        <div>
            <p class="portal-overline">Không gian doanh nghiệp</p>
            <h1>@Model.FullName</h1>
            <p>@Model.Detail</p>
        </div>
        <div class="company-dashboard__actions">
            @if (Model.CanManage)
            {
                <a asp-controller="Positions" asp-action="Create" class="company-dashboard__primary-action">Đăng vị trí thực tập</a>
                <a asp-controller="Applications" asp-action="Index" class="company-dashboard__secondary-action">Xem ứng viên (@Model.PendingApplications)</a>
            }
            else
            {
                <a asp-controller="Profile" asp-action="Index" class="company-dashboard__secondary-action">Xem hồ sơ doanh nghiệp</a>
            }
        </div>
    </header>

    @if (Model.Notice is not null)
    {
        <section class="company-dashboard__notice" role="status">
            <div>
                <strong>Thông tin xét duyệt từ nhà trường</strong>
                <p>@Model.Notice</p>
            </div>
            <a asp-controller="Profile" asp-action="Index">Xem hồ sơ</a>
        </section>
    }

    @if (Model.CanManage)
    {
        <section class="company-dashboard__next">
            @if (Model.TotalPositions == 0)
            {
                <div><p class="portal-overline">Việc cần làm</p><h2>Đăng vị trí thực tập đầu tiên</h2><p>Doanh nghiệp chưa có vị trí tuyển thực tập đang quản lý.</p></div>
                <a asp-controller="Positions" asp-action="Create" class="company-dashboard__primary-action">Đăng vị trí</a>
            }
            else if (Model.PendingApplications > 0)
            {
                <div><p class="portal-overline">Việc cần làm</p><h2>Xử lý @Model.PendingApplications hồ sơ ứng tuyển</h2><p>Các hồ sơ chờ xử lý cần được xem xét trước khi tiếp nhận sinh viên.</p></div>
                <a asp-controller="Applications" asp-action="Index" class="company-dashboard__primary-action">Xem ứng viên</a>
            }
            else if (Model.NotStartedInternships > 0)
            {
                <div><p class="portal-overline">Việc cần làm</p><h2>Xác nhận tiếp nhận @Model.NotStartedInternships sinh viên</h2><p>Gán người hướng dẫn và xác nhận bắt đầu thực tập cho các hồ sơ mới.</p></div>
                <a asp-controller="Internships" asp-action="Index" asp-route-status="0" class="company-dashboard__primary-action">Mở hồ sơ thực tập</a>
            }
            else if (Model.PendingEvaluations > 0)
            {
                <div><p class="portal-overline">Việc cần làm</p><h2>Hoàn tất @Model.PendingEvaluations đánh giá thực tập</h2><p>Các hồ sơ đã kết thúc đang chờ nhận xét và chấm điểm.</p></div>
                <a asp-controller="Internships" asp-action="Index" class="company-dashboard__primary-action">Mở danh sách thực tập</a>
            }
        </section>
    }

    <dl class="company-dashboard__stats">
        <div>
            <dt>Vị trí đang mở</dt>
            <dd>@Model.OpenPositions <span>/ @Model.TotalPositions</span></dd>
            <a asp-controller="Positions" asp-action="Index">Quản lý vị trí</a>
        </div>
        <div>
            <dt>Ứng viên cần xử lý</dt>
            <dd>@Model.PendingApplications <span>/ @Model.TotalApplications</span></dd>
            <a asp-controller="Applications" asp-action="Index">Xem hồ sơ ứng tuyển</a>
        </div>
        <div>
            <dt>Sinh viên đang thực tập</dt>
            <dd>@Model.ActiveInternships <span>/ @Model.TotalInternships</span></dd>
            <a asp-controller="Internships" asp-action="Index">Theo dõi thực tập</a>
        </div>
        <div>
            <dt>Đánh giá cần hoàn tất</dt>
            <dd>@Model.PendingEvaluations <span>hồ sơ</span></dd>
            <a asp-controller="Internships" asp-action="Index">Mở danh sách thực tập</a>
        </div>
    </dl>

    <div class="company-dashboard__grid">
        <section class="company-dashboard__panel">
            <header class="company-dashboard__panel-heading">
                <div>
                    <h2>Ứng viên mới</h2>
                    <p>Hồ sơ ứng tuyển nhận gần đây.</p>
                </div>
                <a asp-controller="Applications" asp-action="Index">Tất cả ứng viên</a>
            </header>

            @if (Model.RecentApplicants.Count == 0)
            {
                <p class="company-dashboard__empty">Chưa có hồ sơ ứng tuyển mới.</p>
            }
            else
            {
                <div class="company-dashboard__table-wrap">
                    <table class="company-dashboard__table">
                        <thead>
                            <tr><th>Ứng viên</th><th>Vị trí</th><th>Trạng thái</th><th></th></tr>
                        </thead>
                        <tbody>
                        @foreach (var application in Model.RecentApplicants)
                        {
                            <tr>
                                <td><strong>@application.FullName</strong><small>@application.StudentCode · @application.CreatedAt.VietnamDateTime()</small></td>
                                <td>@application.PositionTitle</td>
                                <td><span class="company-dashboard__status">@application.Status.DisplayName()</span></td>
                                <td><a asp-controller="Applications" asp-action="Details" asp-route-id="@application.Id">Xem</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="company-dashboard__panel">
            <header class="company-dashboard__panel-heading">
                <div>
                    <h2>Thực tập đang theo dõi</h2>
                    <p>Sinh viên đã được tiếp nhận.</p>
                </div>
                <a asp-controller="Internships" asp-action="Index">Tất cả thực tập</a>
            </header>

            @if (Model.RecentInterns.Count == 0)
            {
                <p class="company-dashboard__empty">Chưa có sinh viên thực tập chính thức.</p>
            }
            else
            {
                <div class="company-dashboard__table-wrap">
                    <table class="company-dashboard__table">
                        <thead>
                            <tr><th>Sinh viên</th><th>Vị trí</th><th>Nhật ký</th><th></th></tr>
                        </thead>
                        <tbody>
                        @foreach (var intern in Model.RecentInterns)
                        {
                            <tr>
                                <td><strong>@intern.FullName</strong><small>@intern.StudentCode · @intern.Status.DisplayName()</small></td>
                                <td>@intern.PositionTitle</td>
                                <td>@intern.DiaryCount nhật ký</td>
                                <td><a asp-controller="Internships" asp-action="Details" asp-route-id="@intern.Id">Xem</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</section>
