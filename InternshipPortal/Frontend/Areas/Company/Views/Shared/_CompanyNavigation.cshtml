@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var items = new[]
    {
        ("Dashboard", "Tổng quan"),
        ("Positions", "Vị trí thực tập"),
        ("Applications", "Ứng viên"),
        ("Internships", "Thực tập & đánh giá"),
        ("Profile", "Hồ sơ doanh nghiệp")
    };
}

<aside class="company-sidebar" aria-label="Điều hướng doanh nghiệp">
    <div class="company-sidebar__header">
        <span>Doanh nghiệp</span>
        <strong>Không gian làm việc</strong>
    </div>
    <nav>
        @foreach (var item in items)
        {
            var isCurrent = controller == item.Item1;
            <a asp-area="Company" asp-controller="@item.Item1" asp-action="Index" class="@(isCurrent ? "is-current" : "")" aria-current="@(isCurrent ? "page" : null)">
                @item.Item2
            </a>
        }
    </nav>
    <div class="company-sidebar__footer">
        <a asp-area="" asp-controller="Home" asp-action="Index">Về cổng thông tin</a>
    </div>
</aside>
