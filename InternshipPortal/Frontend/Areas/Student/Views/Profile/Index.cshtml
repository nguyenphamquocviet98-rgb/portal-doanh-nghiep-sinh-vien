@model InternshipPortal.ViewModels.StudentProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ sinh viên";
}

<section class="student-profile-page">
    <header class="student-profile-header">
        <div>
            <p class="portal-overline">Sinh viên</p>
            <h1>Hồ sơ của tôi</h1>
            <p>Thông tin này được sử dụng khi nộp đơn ứng tuyển và theo dõi quá trình thực tập.</p>
        </div>
        <a asp-action="Edit" class="student-profile-button">Cập nhật hồ sơ</a>
    </header>

    @if (TempData["Success"] is string message)
    {
        <div class="notice-success" role="status">@message</div>
    }

    <div class="student-profile-summary">
        <div class="student-profile-summary__name">
            <span class="student-profile-avatar" aria-hidden="true">@Model.FullName[..1].ToUpperInvariant()</span>
            <div><h2>@Model.FullName</h2><p>@Model.StudentCode · @Model.ClassName</p></div>
        </div>
        <dl>
            <div><dt>Ngành</dt><dd>@Model.MajorName</dd></div>
            <div><dt>Khoa</dt><dd>@Model.FacultyName</dd></div>
            <div><dt>GPA hệ 4</dt><dd>@(Model.Gpa?.ToString("0.00") ?? "Chưa cập nhật")</dd></div>
        </dl>
    </div>

    <div class="student-profile-grid">
        <div class="student-profile-main">
            <section class="student-profile-panel" aria-labelledby="personal-info-title">
                <div class="student-profile-panel__heading"><h2 id="personal-info-title">Thông tin cá nhân</h2></div>
                <dl class="student-profile-details">
                    <div><dt>Email</dt><dd>@Model.Email</dd></div>
                    <div><dt>Điện thoại</dt><dd>@(Model.PhoneNumber ?? "Chưa cập nhật")</dd></div>
                    <div><dt>Mã sinh viên</dt><dd>@Model.StudentCode</dd></div>
                    <div><dt>Lớp</dt><dd>@Model.ClassName</dd></div>
                </dl>
            </section>

            <section class="student-profile-panel" aria-labelledby="skills-title">
                <div class="student-profile-panel__heading"><h2 id="skills-title">Kỹ năng</h2></div>
                <p class="student-profile-content">@(string.IsNullOrWhiteSpace(Model.Skills) ? "Bạn chưa bổ sung kỹ năng. Hãy cập nhật để doanh nghiệp hiểu rõ hơn về năng lực của bạn." : Model.Skills)</p>
            </section>

            <section class="student-profile-panel" aria-labelledby="bio-title">
                <div class="student-profile-panel__heading"><h2 id="bio-title">Giới thiệu bản thân</h2></div>
                <p class="student-profile-content">@(string.IsNullOrWhiteSpace(Model.Bio) ? "Bạn chưa có phần giới thiệu. Hãy thêm định hướng nghề nghiệp hoặc kinh nghiệm nổi bật." : Model.Bio)</p>
            </section>
        </div>

        <aside class="student-profile-cv" aria-labelledby="cv-title">
            <section class="student-profile-panel">
                <div class="student-profile-panel__heading"><h2 id="cv-title">CV và hồ sơ ứng tuyển</h2></div>
                <p class="student-cv-status @(Model.HasCv ? "is-ready" : "is-missing")">
                    @(Model.HasCv ? "CV đã sẵn sàng để nộp đơn." : "Chưa có CV trong hồ sơ.")
                </p>
                @if (Model.HasCv)
                {
                    <a asp-action="DownloadCv" class="student-profile-text-link">Tải CV hiện tại</a>
                }
                else
                {
                    <p class="student-cv-help">Tải file PDF để có thể ứng tuyển vị trí thực tập.</p>
                }

                <a asp-action="Cv" class="student-profile-text-link">Soạn CV theo mẫu</a>

                @if (TempData["CvError"] is string error)
                {
                    <div class="validation-summary" role="alert">@error</div>
                }

                <form asp-action="UploadCv" method="post" enctype="multipart/form-data" class="student-cv-upload">
                    <label for="cv-file">@(Model.HasCv ? "Thay CV mới" : "Chọn file CV")</label>
                    <input id="cv-file" name="file" type="file" accept="application/pdf,.pdf" required aria-describedby="cv-file-hint" />
                    <span id="cv-file-hint">Định dạng PDF, tối đa 10 MB.</span>
                    <button type="submit">Lưu CV</button>
                </form>
            </section>
        </aside>
    </div>
</section>
