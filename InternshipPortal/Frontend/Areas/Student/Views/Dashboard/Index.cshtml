@model InternshipPortal.ViewModels.PortalViewModel
@{ 
    ViewData["Title"] = "Bàn làm việc Sinh viên"; 
}

<partial name="/Frontend/Views/Shared/_PortalHome.cshtml" model="Model" />

<div class="row g-4 mb-4">
    <div class="col-md-6 col-lg-3">
        <a asp-controller="Profile" asp-action="Index" class="card border-0 shadow-sm p-4 rounded-4 bg-white h-100 text-decoration-none transition-card">
            <div class="portal-icon-badge portal-student-badge mb-3">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </div>
            <h3 class="fs-5 fw-bold text-dark mb-1">Hồ sơ sinh viên</h3>
            <p class="small text-muted mb-3">Cập nhật thông tin cá nhân, khoa ngành và tải lên CV PDF.</p>
            <span class="text-primary fw-semibold small mt-auto">Xem hồ sơ →</span>
        </a>
    </div>

    <div class="col-md-6 col-lg-3">
        <a asp-controller="Profile" asp-action="Cv" class="card border-0 shadow-sm p-4 rounded-4 bg-white h-100 text-decoration-none transition-card">
            <div class="portal-icon-badge mb-3" style="background-color: #ecfdf5; color: #059669;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            </div>
            <h3 class="fs-5 fw-bold text-dark mb-1">Mẫu CV trực tuyến</h3>
            <p class="small text-muted mb-3">Soạn thảo CV chuẩn 2 cột A4 chuyên nghiệp để ứng tuyển.</p>
            <span class="text-primary fw-semibold small mt-auto">Soạn CV mẫu →</span>
        </a>
    </div>

    <div class="col-md-6 col-lg-3">
        <a asp-controller="Applications" asp-action="Index" class="card border-0 shadow-sm p-4 rounded-4 bg-white h-100 text-decoration-none transition-card">
            <div class="portal-icon-badge mb-3" style="background-color: #fef3c7; color: #d97706;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
            </div>
            <h3 class="fs-5 fw-bold text-dark mb-1">Lịch sử ứng tuyển</h3>
            <p class="small text-muted mb-3">Theo dõi tiến độ duyệt đơn, lịch phỏng vấn và rút đơn khi cần.</p>
            <span class="text-primary fw-semibold small mt-auto">Xem các đơn nộp →</span>
        </a>
    </div>

    <div class="col-md-6 col-lg-3">
        <a asp-controller="Internships" asp-action="Index" class="card border-0 shadow-sm p-4 rounded-4 bg-white h-100 text-decoration-none transition-card">
            <div class="portal-icon-badge mb-3" style="background-color: #ecfdf5; color: #059669;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <h3 class="fs-5 fw-bold text-dark mb-1">Thực tập & Nhật ký</h3>
            <p class="small text-muted mb-3">Ghi nhật ký tuần, nộp báo cáo thực tập và xem đánh giá cuối kỳ.</p>
            <span class="text-primary fw-semibold small mt-auto">Vào quá trình thực tập →</span>
        </a>
    </div>
</div>

<div class="student-dashboard__opportunities p-4 bg-white border rounded-4 shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div>
        <h4 class="fs-6 fw-bold mb-1">Tìm kiếm cơ hội thực tập mới</h4>
        <p class="small text-muted m-0">Hàng chục vị trí thực tập đang mở tuyển từ các doanh nghiệp đối tác uy tín.</p>
    </div>
    <a asp-area="" asp-controller="Internships" asp-action="Index" class="action-link">
        <span>Khám phá vị trí tuyển dụng</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </a>
</div>
